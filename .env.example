# ==============================================================================
# PROMPTWARS ENVIRONMENT CONFIGURATION
# ==============================================================================
# Get your Google Gemini API Key from Google AI Studio:
# https://aistudio.google.com/app/apikey
#
# NOTE FOR EVALUATORS / JUDGES:
# If this key is not provided or runs out of quota, this application
# automatically switches to "MOCK FALLBACK MODE".
# You will still be able to test 100% of the UI features, prompt inspections,
# and end-to-end user workflows without a crash!
# ==============================================================================

VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Model to use (gemini-2.5-flash or gemini-1.5-pro)
VITE_GEMINI_MODEL=gemini-2.5-flash

# Force mock mode for offline testing (true / false)
VITE_ENABLE_MOCK_FALLBACK=true
