{
  "name": "aeroshield-ai",
  "version": "1.0.0",
  "description": "AeroShield AI (VayuMitra OS) — GenAI Urban Air Quality Defense Companion & Household Smog Defense OS for PromptWars Virtual",
  "homepage": "https://aeroshield-ai-sandy.vercel.app/",
  "repository": {
    "type": "git",
    "url": "https://github.com/mohiddin-ahmed/aeroshield-ai.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "validate": "node scripts/validate-submission.mjs",
    "check:submission": "node scripts/validate-submission.mjs"
  },
  "keywords": [
    "promptwars",
    "vibe-coding",
    "gemini",
    "hack2skill",
    "google-for-developers",
    "antigravity"
  ],
  "author": "Mohiddin Ahmed",
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^3.0.0",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.5.0",
    "jsdom": "^29.0.2",
    "postcss": "^8.5.32",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
